<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E4F0F5" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/drivemate_blue" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/white" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#D6E7EE" />
        </shape>
    </item>
</selector>
