<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drivemate_bg"
    android:layoutDirection="rtl">

<ScrollView
    android:id="@+id/dashboardPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="84dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name_fa"
            android:textColor="@color/drivemate_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aiStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="هوشمندی رانندگی در حال آماده‌سازی"
            android:textColor="@color/drivemate_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/status_panel"
            android:padding="14dp"
            android:text="آماده دریافت فرمان صوتی"
            android:textColor="@color/drivemate_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/mapButton"
            style="@style/HomeActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="نقشه و انتخاب مسیر" />

        <LinearLayout
            android:id="@+id/analysisPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/status_panel"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/analysisTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DriveMate AI"
                android:textColor="@color/drivemate_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/drivemate_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tripStatsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/nav_banner"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tripEtaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tripRemainingText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tripElapsedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tripSpeedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/primary_button"
            android:text="مقصد را بگویید"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="مقصدها"
            android:textColor="@color/drivemate_muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/homeButton" style="@style/NavTabButton" android:text="خانه" />
                <Button android:id="@+id/workButton" style="@style/NavTabButton" android:text="محل کار" />
                <Button android:id="@+id/favoritesButton" style="@style/NavTabButton" android:text="مقصدهای محبوب" />
                <Button android:id="@+id/recentButton" style="@style/NavTabButton" android:layout_marginEnd="0dp" android:text="مقصدهای اخیر" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/settingsButton"
            style="@style/HomeActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="تنظیمات برنامه" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="امکانات دیگر"
            android:textColor="@color/drivemate_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveButton"
                    style="@style/HomeActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="ذخیره مکان جدید" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/HomeActionButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="توقف مسیریابی" />
            </LinearLayout>

            <Button
                android:id="@+id/notificationButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="اعلان مسیریابی" />

            <TextView
                android:id="@+id/intelligenceModeInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="همراه راننده برای مدیریت مصرف و کیفیت پاسخ‌ها دو حالت دارد.\nحالت اقتصادی مصرف کمتری دارد و برای استفاده روزمره مناسب است.\nحالت هوشمند کامل از توانایی‌های بیشتر هوش مصنوعی برای تحلیل دقیق‌تر استفاده می‌کند."
                android:textColor="@color/drivemate_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/intelligenceButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="هوشمندی رانندگی" />

            <Button
                android:id="@+id/backupButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="پشتیبان‌گیری و بازیابی" />
        </LinearLayout>

        <TextView
            android:id="@+id/listText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/drivemate_muted"
            android:textSize="15sp" />
    </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/savedPlacesPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="20dp"
        android:paddingBottom="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ذخیره‌ها"
                android:textColor="@color/drivemate_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="مکان‌های شخصی، خانه، محل کار و مقصدهای محبوب"
                android:textColor="@color/drivemate_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/addSavedPlaceTabButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="ذخیره مکان فعلی" />

            <TextView
                android:id="@+id/savedPlacesTabText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/status_panel"
                android:padding="14dp"
                android:textColor="@color/drivemate_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/manageSavedPlacesTabButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="مدیریت و ویرایش ذخیره‌ها" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/profilePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="20dp"
        android:paddingBottom="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="پروفایل"
                android:textColor="@color/drivemate_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="مدیریت تجربه DriveMate AI"
                android:textColor="@color/drivemate_muted"
                android:textSize="14sp" />

            <Button android:id="@+id/profileSettingsButton" style="@style/HomeActionButton" android:layout_width="match_parent" android:layout_marginTop="16dp" android:text="تنظیمات" />
            <Button android:id="@+id/profileSubscriptionButton" style="@style/HomeActionButton" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="اشتراک" />
            <Button android:id="@+id/profileBackupButton" style="@style/HomeActionButton" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="پشتیبان‌گیری و بازگردانی" />
            <Button android:id="@+id/profileTripsButton" style="@style/HomeActionButton" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="گزارش سفرها" />
            <Button android:id="@+id/profileAboutButton" style="@style/HomeActionButton" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="درباره برنامه" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/tripHistoryPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="20dp"
        android:paddingBottom="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="گزارش سفرها"
                android:textColor="@color/drivemate_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="هر کارت مربوط به یک سفر است. برای دیدن جزئیات آن را انتخاب کنید."
                android:textColor="@color/drivemate_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/exportTripReportsButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="ذخیره گزارش‌ها (CSV)" />

            <Button
                android:id="@+id/closeTripHistoryButton"
                style="@style/HomeActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="بازگشت به پروفایل" />

            <LinearLayout
                android:id="@+id/tripHistoryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/mainBottomTabs"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button android:id="@+id/tabDashboardButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:text="داشبورد" />
        <Button android:id="@+id/tabMapButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:text="نقشه" />
        <Button android:id="@+id/tabSavedButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:text="ذخیره‌ها" />
        <Button android:id="@+id/tabProfileButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:text="پروفایل" />
    </LinearLayout>
</FrameLayout>
