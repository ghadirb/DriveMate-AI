<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drivemate_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name_fa"
            android:textColor="@color/drivemate_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aiStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="هوشمندی رانندگی در حال آماده‌سازی"
            android:textColor="@color/drivemate_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/status_panel"
            android:padding="14dp"
            android:text="آماده دریافت فرمان صوتی"
            android:textColor="@color/drivemate_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/mapButton"
            style="@style/HomeActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="نقشه و انتخاب مسیر" />

        <LinearLayout
            android:id="@+id/analysisPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/status_panel"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/analysisTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DriveMate AI"
                android:textColor="@color/drivemate_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/drivemate_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tripStatsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/nav_banner"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tripEtaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tripRemainingText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tripElapsedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tripSpeedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/primary_button"
            android:text="مقصد را بگویید"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="مقصدها"
            android:textColor="@color/drivemate_muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/homeButton" style="@style/NavTabButton" android:text="خانه" />
                <Button android:id="@+id/workButton" style="@style/NavTabButton" android:text="محل کار" />
                <Button android:id="@+id/favoritesButton" style="@style/NavTabButton" android:text="مقصدهای محبوب" />
                <Button android:id="@+id/recentButton" style="@style/NavTabButton" android:layout_marginEnd="0dp" android:text="مقصدهای اخیر" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/settingsButton"
            style="@style/HomeActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="تنظیمات برنامه" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="امکانات دیگر"
            android:textColor="@color/drivemate_muted"
            android:textSize="13sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <Button android:id="@+id/saveButton" style="@style/HomeActionButton" android:text="ذخیره مکان جدید" />
            <Button android:id="@+id/stopButton" style="@style/HomeActionButton" android:text="توقف مسیریابی" />
            <Button android:id="@+id/notificationButton" style="@style/HomeActionButton" android:text="اعلان مسیریابی" />
            <Button android:id="@+id/intelligenceButton" style="@style/HomeActionButton" android:layout_columnSpan="2" android:text="هوشمندی رانندگی" />
            <Button android:id="@+id/backupButton" style="@style/HomeActionButton" android:layout_columnSpan="2" android:text="پشتیبان‌گیری و بازیابی" />
        </GridLayout>

        <TextView
            android:id="@+id/listText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/drivemate_muted"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
