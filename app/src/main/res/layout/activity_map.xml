<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drivemate_bg"
    android:layoutDirection="rtl">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/turnBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nav_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/turnArrowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="↑"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/turnDistanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/turnInstructionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/turnExpandIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="▾"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/laneGuidanceRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nav_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/roadSpeedLimitText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:background="@drawable/status_panel"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="محدودیت: نامشخص"
            android:textColor="@color/drivemate_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/turnStepsScroll"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/status_panel"
            android:elevation="6dp"
            android:fillViewport="true"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/turnStepsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/mapSearchBarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/status_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/mapSearchText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="جست‌وجوی مکان یا آدرس"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/drivemate_text"
                android:textColorHint="@color/drivemate_muted" />

            <ProgressBar
                android:id="@+id/mapSearchProgress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/mapSearchClearButton"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="پاک کردن جستجو"
                android:text="×"
                android:textSize="24sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/mapSearchButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="جست‌وجو" />

            <Button
                android:id="@+id/mapCloseButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="بازگشت به صفحه اصلی"
                android:text="×"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/searchResultsPanel"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/status_panel"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:fillViewport="true"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/searchResultsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/myLocationButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="مکان فعلی"
            android:text="من" />

        <Button
            android:id="@+id/savedPlacesButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:contentDescription="مکان‌های ذخیره‌شده"
            android:text="مکان" />

        <Button
            android:id="@+id/nearMeButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:contentDescription="اطراف من"
            android:textSize="11sp"
            android:text="اطراف من" />

        <Button
            android:id="@+id/mapLayersButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:contentDescription="تنظیمات نقشه و لایه‌ها"
            android:text="لایه‌ها"
            android:textSize="10sp" />

        <Button
            android:id="@+id/drivingOverviewButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:contentDescription="نمای کلی مسیر"
            android:text="نما"
            android:visibility="gone" />

        <Button
            android:id="@+id/navigationCameraButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:contentDescription="نمای رانندگی و دنبال کردن خودرو"
            android:text="3D"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapRoutePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="68dp"
        android:background="@drawable/status_panel"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mapDestinationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mapDestinationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/drivemate_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mapRouteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="مبدأ: مکان فعلی"
                android:textColor="@color/drivemate_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/routeOptionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/routeOptionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/routeOptionsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="نمای کامل مسیر" />

            <Button
                android:id="@+id/saveMapPlaceButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="ذخیره مکان" />

            <Button
                android:id="@+id/routeWaypointsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="توقف‌ها"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/startMapNavigationButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/primary_button"
            android:text="شروع مسیریابی"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/stopMapNavigationButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="توقف مسیریابی"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapBottomTabs"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button android:id="@+id/mapTabDashboardButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:text="داشبورد" />
        <Button android:id="@+id/mapTabMapButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:text="نقشه" />
        <Button android:id="@+id/mapTabSavedButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:text="ذخیره‌ها" />
        <Button android:id="@+id/mapTabProfileButton" style="@style/NavTabButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:text="پروفایل" />
    </LinearLayout>
</FrameLayout>
